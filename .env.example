# Groq API Key (get free at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Optional: Override default models
# GROQ_MODEL=llama-3.3-70b-versatile
# CLOUD_MAX_TOKENS=4096
# GROQ_MIN_REQUEST_INTERVAL=8
# GROQ_RATE_LIMIT_BUFFER=5
# GROQ_CONTINUATION_ATTEMPTS=1
# Set true only if you want to spend multiple keys aggressively instead of waiting.
# GROQ_ROTATE_ON_RATE_LIMIT=false
# LLAMA_MODELS_DIR=./models
# LLAMA_MODEL_PATH=./models/mistral-7b-instruct-v0.2.Q4_K_M.gguf
# LLAMA_PROMPT_TEMPLATE=mistral

# llama.cpp tuning for RTX 4050-class GPUs. Start conservative, then raise layers.
# LLAMA_N_GPU_LAYERS=20
# LLAMA_N_BATCH=512
# LLAMA_N_THREADS=8
# LLAMA_F16_KV=true
# LOCAL_NUM_CTX=4096

# Local-only by default. Set true only if you want Groq used for generation.
# USE_CLOUD_MODEL=false
