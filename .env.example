# ──────────────────────────────────────────────────────────────────────────────
# Story Teller — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file.
# ──────────────────────────────────────────────────────────────────────────────

# ── Backend Selection ─────────────────────────────────────────────────────────
# Options: local | groq | gemini | openrouter | hybrid
BACKEND_MODE=local

# ── Groq API ────────────────────────────────────────────────────────────────
# Get keys at https://console.groq.com. Credentials do not create extra quota.
GROQ_API_KEY=your_groq_api_key_here
# Optional credentials for manual replacement; all share the workload ledger.
# GROQ_API_KEYS=gsk_key1...,gsk_key2...
# GROQ_MODEL=qwen/qwen3.8-27b
# Optional additional fixed spacing; RPM/TPM admission already controls bursts.
# GROQ_MIN_REQUEST_INTERVAL=0.0
# GROQ_RATE_LIMIT_BUFFER=5.0
# Legacy rotation flags no longer rotate accounts to overcome quota exhaustion.
# GROQ_ROTATE_ON_RATE_LIMIT=false
# GROQ_PROACTIVE_ROTATION=false
# KEY_ROTATION_STRATEGY=round_robin
# GROQ_CONTINUATION_ATTEMPTS=1
# Set these to actual model/organization Console ceilings, including other apps.
# Defaults are conservative starting values, not verified account entitlements.
# GROQ_RPM_LIMIT=30
# GROQ_TPM_LIMIT=6000
# GROQ_RPD_LIMIT=1000
# GROQ_TPD_LIMIT=200000
# GROQ_ITPM_LIMIT=0
# GROQ_OTPM_LIMIT=0
# GROQ_TPM_SAFETY_MARGIN=0.20
# GROQ_QUOTA_GROUP=story-teller
# GROQ_QUOTA_DB=runtime/quotas.sqlite3
# Use configured Gemini for support/backup after a structured live health check.
# GROQ_SUPPORT_BACKEND=gemini
# GROQ_BACKUP_WAIT_SECONDS=20
# All scene expansions, patches, rewrites, candidates and polish share this cap.
# SCENE_REPAIR_CALLS=2
# start.sh enables durable automatic/batch chapter recovery; Stop cancels it.
# STORY_AUTO_RESUME=true
# Route Planner/Critic/Editor/Verifier to local GGUF, keeping Groq for the Writer.
# Only active when a local model is present and loadable.
# HYBRID_ROUTING=true

# ── Gemini API (Multi-Account Supported) ──────────────────────────────────────
# Required for Combine & Polish feature
# Get keys at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Multi-account rotation pool for Gemini:
# GEMINI_API_KEYS=AIza_account1...,AIza_account2...
# GEMINI_ROTATE_ON_RATE_LIMIT=true
# GEMINI_PROACTIVE_ROTATION=false
# GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_TPM_LIMIT=200000

# ── OpenRouter API (Multi-Account Supported) ──────────────────────────────────
# Optional alternative cloud backend — https://openrouter.ai
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# Multi-account rotation pool for OpenRouter:
# OPENROUTER_API_KEYS=sk-or-account1...,sk-or-account2...
# OPENROUTER_ROTATE_ON_RATE_LIMIT=true
# OPENROUTER_PROACTIVE_ROTATION=false
# OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# OPENROUTER_MIN_REQUEST_INTERVAL=1.0

# ── Local llama.cpp ───────────────────────────────────────────────────────────
# Place a .gguf model file in ./models/ or point LLAMA_MODEL_PATH elsewhere.
# LLAMA_MODELS_DIR=./models
# LLAMA_MODEL_PATH=./models/your-model.gguf
# LLAMA_PROMPT_TEMPLATE=mistral    # mistral | llama3 | chatml
# LLAMA_N_GPU_LAYERS=20            # GPU offload layers (raise for better speed)
# LLAMA_N_BATCH=512
# LLAMA_N_THREADS=8
# LLAMA_F16_KV=true
# LOCAL_NUM_CTX=4096

# ── Generation Tuning ─────────────────────────────────────────────────────────
# LOCAL_TEMPERATURE=0.7
# LOCAL_TOP_P=0.9
# LOCAL_MAX_TOKENS=1024
# LOCAL_STRUCTURED_MAX_TOKENS=900
# CLOUD_TEMPERATURE=0.8
# CLOUD_TOP_P=0.9
# CLOUD_MAX_TOKENS=4096

# ── Pipeline Limits ───────────────────────────────────────────────────────────
# WORDS_PER_SCENE_MIN=500
# WORDS_PER_SCENE_MAX=1000
# MIN_SCENE_WORDS=500
# MAX_SCENE_ITERATIONS=5
# MAX_PIPELINE_STEPS=300
# MAX_TOKEN_BUDGET=24000

# ── Memory / Retrieval ────────────────────────────────────────────────────────
# Keep embedding model loading offline-only (default).
# Set false once to allow a first-run Hugging Face download.
EMBEDDING_LOCAL_FILES_ONLY=true
# TOP_K_RETRIEVAL=4
# CONTEXT_TOKEN_BUDGET=2048

# ── Retry / Rate-limit Backoff ────────────────────────────────────────────────
# RETRY_BASE_DELAY=3.0
# RETRY_MAX_DELAY=30.0
# RETRY_BACKOFF_FACTOR=2.0

# ── Flask / Server ────────────────────────────────────────────────────────────
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
# Set false in production. Never expose debug mode publicly.
FLASK_DEBUG=false
# SSE_QUEUE_MAXSIZE=1000

# ── Optional local rotating proxy ─────────────────────────────────────────────
# Run: python proxy_rotator.py --proxies "$ROTATING_PROXY_URLS"
# Use trusted HTTP upstreams; credentials may be embedded as user:password@host.
# ROTATING_PROXY_HOST=127.0.0.1
# ROTATING_PROXY_PORT=8080
# ROTATING_PROXY_URLS=http://user:password@proxy1.example:3128,http://proxy2.example:3128
